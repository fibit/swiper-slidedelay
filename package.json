{
  "name": "swiper-slidedelay",
  "version": "1.1.0",
  "description": "SlideDelay plugin for Swiper",
  "files": [
    "swiper-slidedelay.js",
    "swiper-slidedelay.min.js",
    "swiper-slidedelay.mjs"
  ],
  "main": "swiper-slidedelay.js",
  "module": "swiper-slidedelay.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./swiper-slidedelay.mjs",
      "require": "./swiper-slidedelay.js",
      "default": "./swiper-slidedelay.js"
    },
    "./swiper-slidedelay.js": "./swiper-slidedelay.js",
    "./swiper-slidedelay.min.js": "./swiper-slidedelay.min.js",
    "./swiper-slidedelay.mjs": "./swiper-slidedelay.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "echo \"Tests skipped\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fibit/swiper-slidedelay.git"
  },
  "keywords": [
    "swiper",
    "swiper-plugin",
    "slider",
    "carousel",
    "autoplay",
    "delay"
  ],
  "author": "Pavel Romanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fibit/swiper-slidedelay/issues"
  },
  "homepage": "https://github.com/fibit/swiper-slidedelay#readme",
  "peerDependencies": {
    "swiper": ">=11.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
